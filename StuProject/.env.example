# ==============================================================================
# Frontend Issue Agent - 环境变量示例
# 复制为 .env 后按需修改；.env 不会进入 git
# ==============================================================================

# ---------- API 服务 ----------
API_PORT=4000
API_LOG_LEVEL=info

# ---------- Worker ----------
WORKER_CONCURRENCY=2

# ---------- PostgreSQL (Day 3 启用) ----------
# 本机 Docker Compose 默认值
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=agent
PG_PASSWORD=agent_dev_pw
PG_DATABASE=issue_agent
PG_POOL_MAX=10
# node-pg-migrate 使用。保留单独变量便于 CLI、CI 和生产连接串场景。
DATABASE_URL=postgres://agent:agent_dev_pw@127.0.0.1:5432/issue_agent

# ---------- Redis (Day 5 启用) ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 生产建议启用密码；本地开发留空
REDIS_PASSWORD=

# ---------- LLM (Week 2 启用) ----------
# OpenAI 兼容接口：base URL 可指向 OpenAI/DeepSeek/通义/自建等
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# 没有 Key 时代码会自动 fallback 到 FakeModelProvider
