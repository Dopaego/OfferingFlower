{
  "name": "frontend-issue-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend Issue Agent — 学习作品：LLM + Tool Calling + PostgreSQL + Redis + BullMQ + Playwright",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "typecheck": "tsc --build",
    "typecheck:clean": "tsc --build --clean",
    "typecheck:watch": "tsc --build --watch",
    "db:migrate": "npm run migrate --workspace @stu/db",
    "db:migrate:down": "npm run migrate:down --workspace @stu/db",
    "dev:api": "npm run dev --workspace @stu/api",
    "dev:worker": "npm run dev --workspace @stu/worker",
    "test": "npm run test --workspaces --if-present",
    "lint": "echo \"[lint] 尚未配置 eslint —— Day 4 补齐\" && exit 0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
